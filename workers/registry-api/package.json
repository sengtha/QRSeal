{
  "name": "@kh-sqr/registry-api",
  "version": "1.0.0",
  "private": true,
  "description": "Accepts issuer CSRs, queues them for the offline Root ceremony, and publishes issued certificates. Holds no key.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply kh-sqr-registry --local",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260830.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.127.1"
  }
}
