{
  "name": "kh-sqr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "test": "vitest run",
    "test:workers": "pnpm -r --filter ./workers/** run test",
    "vectors:generate": "node --experimental-strip-types tools/generate-vectors.ts",
    "vectors:check": "node --experimental-strip-types tools/generate-vectors.ts --check",
    "measure:qr": "node --experimental-strip-types tools/measure-qr.ts",
    "check:profile-a-isolation": "node --experimental-strip-types tools/check-profile-a-isolation.ts",
    "check:no-signing-keys": "node --experimental-strip-types tools/check-no-signing-keys.ts",
    "check:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm vectors:check && pnpm check:profile-a-isolation && pnpm check:no-signing-keys"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.10.2",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "cbor2": "^2.0.1",
    "eslint": "^9.39.1",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
